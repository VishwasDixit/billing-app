# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# MongoDB Atlas connection string. Leave empty locally to use a built-in local database.
MONGODB_URI=
MONGODB_DB=billing

# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Your login email(s). These accounts get the Admin panel and never expire. Comma-separated.
ADMIN_EMAIL=

# Razorpay (Dashboard → Account & Settings → API Keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://<your-app>/api/pay/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Payment page link (e.g. https://razorpay.me/@yourname). Shopkeepers pay there and
# submit the Razorpay payment ID; you approve it in Admin.
PAYMENT_LINK=

# Manual UPI payments: your UPI ID and the name shown in the payer's app.
UPI_ID=
UPI_NAME=
